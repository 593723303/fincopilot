# ───────────────────────────────────────────────
# 复制为 .env 后填写。.env 已被 gitignore，绝不提交。
# ───────────────────────────────────────────────

# ── 模型平台（M0 冒烟测试需要，本地存储验证不需要）──
# 阿里云百炼：LLM / Embedding / Rerank / 文档解析
DASHSCOPE_API_KEY=

# 备用模型，用于降级与成本路由（可暂时留空）
DEEPSEEK_API_KEY=

# ── 存储（默认值对应 docker-compose 本地环境，可直接用）──
# 注意用 127.0.0.1 而不是 localhost：Windows 上 localhost 优先解析到 IPv6 ::1，
# 而容器端口转发（Podman rootlessport / Docker Desktop）只监听 IPv4，
# 用 localhost 会连接挂起直到超时，且错误信息完全看不出是解析问题。
POSTGRES_DSN=postgresql+asyncpg://fincopilot:fincopilot@127.0.0.1:5432/fincopilot
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ── 可观测（留空则本地运行时自动跳过上报，不阻塞开发）──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 运行时 ──
APP_ENV=local
LOG_LEVEL=INFO
EXP_ID=exp01_baseline
